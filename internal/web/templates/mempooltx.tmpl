{{define "body"}}
<h1>Mempool Transaction</h1>
{{if eq .Snapshot.Status "fresh"}}
<p class="status-line"><strong>UNCONFIRMED / MEMPOOL</strong></p>
{{else}}
<p class="status-line">Present in cached mempool snapshot &mdash; the confirmed indexed tip no longer matches this snapshot's anchor. Membership in Core's current mempool is not confirmed by this page.</p>
{{end}}

<table class="kv-table">
<tr><th>TxID</th><td class="mono wrap">{{.TxID}}</td></tr>
<tr><th>WTxID</th><td class="mono wrap">{{.WTxID}}</td></tr>
<tr><th>Version</th><td>{{.Version}}</td></tr>
<tr><th>Locktime</th><td>{{.LockTime}}</td></tr>
<tr><th>Size</th><td>{{.Size}} bytes</td></tr>
<tr><th>VSize</th><td>{{.VSize}}</td></tr>
<tr><th>Weight</th><td>{{.Weight}}</td></tr>
<tr><th>Fee</th><td>{{.FeeQOGE}} QOGE <span class="muted">({{.FeeSatoshis}} sats)</span></td></tr>
<tr><th>Entry Time</th><td>{{formatTimeUTC .EntryTime}}</td></tr>
{{if .EntryHeight}}<tr><th>Entry Height</th><td>{{.EntryHeight}}</td></tr>{{end}}
<tr><th>Replaceable</th><td>{{replaceableLabel .Replaceable}}</td></tr>
</table>

<h2>Snapshot</h2>
<table class="kv-table">
<tr><th>Status</th><td>{{.Snapshot.Status}}</td></tr>
<tr><th>Generation</th><td>{{.Snapshot.Generation}}</td></tr>
<tr><th>Observed</th><td>{{formatObservedAt .Snapshot.ObservedAt}}</td></tr>
<tr><th>Anchor Height</th><td>{{if .Snapshot.CoreTipHeight}}{{.Snapshot.CoreTipHeight}}{{end}}</td></tr>
<tr><th>Anchor Hash</th><td class="mono wrap">{{if .Snapshot.CoreTipHash}}{{.Snapshot.CoreTipHash}}{{end}}</td></tr>
<tr><th>Confirmed Indexed Height</th><td>{{.Snapshot.ConfirmedIndexedHeight}}</td></tr>
</table>

<h2>Dependencies</h2>
{{if .Depends}}
<ul>{{range .Depends}}<li><a class="mono wrap" href="/mempool/tx/{{.}}">{{.}}</a></li>{{end}}</ul>
{{else}}
<p class="muted">No in-mempool dependencies.</p>
{{end}}

<h2>Inputs</h2>
{{range .Inputs}}
<div class="io-card">
  <div class="io-title">Input #{{.VinIndex}}</div>
  <div>Previous output: <a class="mono wrap" href="{{prevOutLink .PrevTxID $.Depends}}">{{.PrevTxID}}</a>:{{.PrevVoutIndex}}</div>
  <div>ScriptSig: <code class="mono wrap">{{.ScriptSigHex}}</code></div>
  <div>Sequence: {{.Sequence}}</div>
  {{if .Witness}}
  <div class="witness-block">
    <div class="witness-heading">Witness ({{len .Witness}} item(s))</div>
    {{range .Witness}}
    <div class="witness-item">
      Item {{.ItemIndex}}: {{.SizeBytes}} bytes
      {{if .DataHex}}
      <pre class="raw-hex"><code>{{.DataHex}}</code></pre>
      {{else}}
      <span class="muted">(raw data hidden by default)</span>
      {{end}}
    </div>
    {{end}}
  </div>
  {{end}}
</div>
{{else}}
<p class="muted">No inputs.</p>
{{end}}

{{if .IncludeWitness}}
<p><a href="/mempool/tx/{{.TxID}}">Hide raw witness data</a></p>
{{else}}
<p><a href="/mempool/tx/{{.TxID}}?include_witness=true">Show raw witness data (may be large)</a></p>
{{end}}

<h2>Outputs</h2>
{{range .Outputs}}
<div class="io-card">
  <div class="io-title">Output #{{.VoutIndex}} &mdash; {{.ScriptType}}</div>
  <div>Value: {{.ValueQOGE}} QOGE <span class="muted">({{.ValueSatoshis}} sats)</span></div>
  {{if .Address}}<div>Address: <a class="mono wrap" href="/address/{{.Address}}">{{.Address}}</a></div>{{end}}
  <div>ScriptPubKey: <code class="mono wrap">{{.ScriptPubKeyHex}}</code></div>
  {{if .WitnessVersion}}<div>Witness version: {{.WitnessVersion}}</div>{{end}}
  {{if .WitnessProgram}}<div>Witness program: <code class="mono wrap">{{.WitnessProgram}}</code></div>{{end}}
  {{if .Participants}}
  <div>Participants (not independent balance owners):
    <ul>{{range .Participants}}<li><a class="mono wrap" href="/address/{{.}}">{{.}}</a></li>{{end}}</ul>
  </div>
  {{end}}
</div>
{{else}}
<p class="muted">No outputs.</p>
{{end}}
{{end}}
